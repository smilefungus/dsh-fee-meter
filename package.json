{
  "name": "dsh-fee-meter",
  "version": "0.2.0",
  "description": "DeepSeek Harness 费用看板插件:右下角悬浮按钮 + 500×600 浮窗 iframe 嵌入费用报表页。Cost dashboard plugin for DeepSeek Harness: bottom-right floating button opens a 500×600 panel with an iframe-embedded report.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "费用看板 / fee-meter",
    "summary": "DeepSeek Harness 费用看板:右下角悬浮按钮 + 浮窗嵌入费用报表。",
    "categories": [
      "费用",
      "Web UI"
    ],
    "surfaces": [
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.1.0-rc.5",
      "node": ">=20"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "fee"
  ],
  "license": "MIT"
}
